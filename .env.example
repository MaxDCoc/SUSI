# Copiar a .env y completar. NUNCA subir .env al repositorio.
# Evitar los caracteres @ : / en POSTGRES_PASSWORD (va dentro de una URL).
POSTGRES_PASSWORD=cambiar-esta-clave
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=generar-una-clave-larga-y-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Poner 1 solo si se publica detrás de HTTPS.
DJANGO_SECURE_COOKIES=0
# Contraseña de los usuarios de demo (admin.demo, responsable.demo, validador.demo).
SUSI_DEMO_PASSWORD=cambiar-la-clave-de-demo
SUSI_GREENOPS=1

# --- Solo para un despliegue en la nube (ver docs/deploy-render-supabase.md). Local no hace falta. ---
# Detrás de un proxy que termina HTTPS (Render): confiar en X-Forwarded-Proto.
# DJANGO_BEHIND_PROXY=1
# Base de datos externa (Supabase "Session pooler"). Si se usa el pooler en modo transacción (puerto 6543): 1.
# DATABASE_URL=postgresql://usuario:clave@host:5432/postgres
# DATABASE_DISABLE_PREPARED=1
# Evidencias en un bucket S3 privado (Supabase Storage). Se necesitan las cinco juntas.
# SUSI_S3_ENDPOINT_URL=https://<proyecto>.supabase.co/storage/v1/s3
# SUSI_S3_BUCKET=evidencias
# SUSI_S3_REGION=us-east-1
# SUSI_S3_ACCESS_KEY=
# SUSI_S3_SECRET_KEY=
